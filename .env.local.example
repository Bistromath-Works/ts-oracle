# Embedding model — used at query time by the MCP server and at index time
#
# Option A: Local Ollama (recommended — no API costs, no rate limits)
# Install Ollama and run: ollama pull nomic-embed-text-v2-moe
# No env vars needed — server defaults to http://localhost:11434
#
# Option B: Hosted API (e.g. Gemini free tier for query-time use)
# OLLAMA_BASE_URL=https://your-embedding-api.com
# EMBEDDING_API_KEY=your-key

# Optional: override the path to the bundled SQLite database
# CORPUS_DB_PATH=/path/to/corpus.db
